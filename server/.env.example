# Server
PORT=8790
NODE_ENV=development
PROJECT_OS_APP_NAME=Project OS for Codex

# Auth bootstrap. Empty means password auth is not bootstrapped from env.
PROJECT_OS_AUTH_USER=
PROJECT_OS_AUTH_PASSWORD=
# Local development only. Production refuses to start without password auth.
PROJECT_OS_DEV_NO_AUTH=false

# Persistent storage. Must be a durable volume in production.
PROJECT_OS_DATA_DIR=./data

# Public URL of this app/API, used when generating handoff links and public metadata.
PROJECT_OS_PUBLIC_BASE=http://localhost:8790

# Cookie path. Keep "/" unless deploying under a sub-path.
PROJECT_OS_COOKIE_PATH=/

# Git repository exposure.
# If empty, handoff pages display the local repo path.
GIT_PUBLIC_BASE=
GIT_PUBLIC_DIR=

# AI provider adapter.
# Must be OpenAI-compatible: /chat/completions and /embeddings.
# Keep real keys out of Git.
PROJECT_OS_AI_BASE=
PROJECT_OS_AI_KEY=
PROJECT_OS_AI_PUBLIC_BASE=
PROJECT_OS_AI_MODEL=
PROJECT_OS_EMBEDDING_MODEL=

# Optional external knowledge import directory.
PROJECT_OS_KB_DIR=
